# PayPal Sandbox credentials
# Get these from developer.paypal.com → Apps & Credentials → Sandbox app
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# PayPal mode: "fake" (offline, no credentials needed) or "sandbox"
PAYPAL_MODE=fake

# Optional: fix credentials so they don't rotate on restart
# AGENT_API_KEY=agent_your_key_here
# DEMO_PASSWORD=your_demo_password
# ADMIN_KEY=your_admin_key_here

# Optional live AI assistant (Gemini takes priority if both providers are configured)
# GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Set to 1 when serving over HTTPS
# COOKIE_SECURE=1

# PayPal merchant ID for extra payee verification (optional)
# PAYPAL_MERCHANT_ID=your_merchant_id
