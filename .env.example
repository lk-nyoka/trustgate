# Copy to .env. Never commit .env or .vault_token.json.
PAYPAL_MODE=fake                 # fake (offline) or sandbox
# --- PayPal Sandbox (developer.paypal.com) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_VAULT_ID=                 # or keep .vault_token.json from spikes/spike2_vault.py
