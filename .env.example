# --- PayPal Sandbox (only for PAYPAL_MODE=sandbox) ---------------------------------
# developer.paypal.com -> Apps & Credentials -> Sandbox app
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
# PAYPAL_VAULT_ID=...        # vaulted payment method id, if not in .vault_token.json
# PAYPAL_MERCHANT_ID=...     # optional extra payee verification

# "fake" (offline, no credentials, default) or "sandbox"
PAYPAL_MODE=fake

# --- Production (APP_ENV=production refuses to start without these) -----------------
# APP_ENV=production
# DEMO_PASSWORD=at-least-12-characters
# ADMIN_KEY=long-random-string
# CSRF_SECRET=long-random-string
# AGENT_API_KEY=at-least-24-characters      # sandbox mode only
# COOKIE_SECURE=1
# AUDIT_PATH=/data/audit.jsonl              # persist the hash-chained audit log (sandbox mode)
# RATE_LIMIT_PER_MIN=120
# LOGIN_LIMIT_PER_MIN=10
# TRUSTED_PROXY_HOPS=0                      # number of trusted proxies in front of the app
# PLAYGROUND=1                              # set 0 to disable the public /try page
# PLAYGROUND_MAX_RUNS=2000
# REPO_URL=https://github.com/lk-nyoka/trustgate

# --- Optional live AI (Gemini wins if both are set; neither = scripted stand-ins) ----
# GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-sonnet-5-5
